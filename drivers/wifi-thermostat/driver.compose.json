{
  "name": {
    "en": "Computherm Wifi thermostat"
  },
  "class": "thermostat",
  "capabilities": [
    "onoff",
    "thermostat_mode",
    "target_temperature",
    "measure_temperature"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "step": 0.5,
      "decimals": 1,
      "min": 15,
      "max": 30
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.jpg",
    "large": "{{driverAssetsPath}}/images/large.jpg",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.jpg"
  },
  "pair": [
    {
      "id": "instructions",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "prev": "instructions",
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "discovery": "thermostat_mac"
}
